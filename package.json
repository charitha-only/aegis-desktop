{
  "name": "aegis-desktop",
  "version": "1.1.0",
  "description": "High-Security Cross-Platform Desktop Application Framework built with Rust and React",
  "license": "MIT",
  "scripts": {
    "setup": "npm install && npm --prefix src-ui install",
    "dev": "node aegis-cli/bin/aegis.js dev",
    "dev:ui": "npm --prefix src-ui run dev",
    "dev:core": "cargo run --manifest-path src-core/Cargo.toml",
    "build": "node aegis-cli/bin/aegis.js build",
    "build:release": "node aegis-cli/bin/aegis.js build-release",
    "bundle": "node aegis-cli/bin/aegis.js bundle",
    "test": "cargo test --manifest-path src-core/Cargo.toml && npm run test:smoke && npm run test:benchmark",
    "test:smoke": "node aegis-cli/bin/smoke-suite.js",
    "test:security": "node aegis-cli/bin/aegis.js test-security",
    "test:sensitive": "node aegis-cli/bin/sensitive-smoke.js",
    "test:sessions": "node aegis-cli/bin/session-smoke.js",
    "test:benchmark": "node aegis-cli/bin/benchmark.js",
    "doctor": "node aegis-cli/bin/aegis.js doctor",
    "package": "node aegis-cli/bin/aegis.js package",
    "package:all": "node scripts/package-cross-platform.mjs",
    "site:dev": "npm --prefix website run dev",
    "site:build": "npm --prefix website run build",
    "sbom:generate": "node scripts/generate-sbom.mjs",
    "sbom:verify": "node scripts/generate-sbom.mjs --verify",
    "release": "powershell -ExecutionPolicy Bypass -File scripts/release.ps1",
    "release:minor": "powershell -ExecutionPolicy Bypass -File scripts/release.ps1 minor",
    "release:major": "powershell -ExecutionPolicy Bypass -File scripts/release.ps1 major"
  },
  "keywords": [
    "desktop",
    "framework",
    "rust",
    "react",
    "vite",
    "security",
    "zero-trust",
    "sandbox",
    "cross-platform"
  ],
  "author": "Aegis Desktop Contributors"
}
